# Copy to .env and fill in. .env is gitignored - never commit it.
#
# Default setup needs ONE key: Anthropic. Embeddings run locally.

ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------- providers
# LLM:        anthropic (default) | openai
# Embeddings: local (default)     | openai | voyage
RAGBENCH_LLM_PROVIDER=anthropic
RAGBENCH_EMBED_PROVIDER=local

# Models. Leave unset to use the provider's default.
#   anthropic -> claude-haiku-4-5-20251001   openai -> gpt-4o-mini
# RAGBENCH_GEN_MODEL=claude-haiku-4-5-20251001
# RAGBENCH_JUDGE_MODEL=claude-haiku-4-5-20251001
#   local -> BAAI/bge-small-en-v1.5   openai -> text-embedding-3-small   voyage -> voyage-3
# RAGBENCH_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Only needed if you switch a provider above to openai / voyage.
# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=pa-...

# ---------------------------------------------------------------- retrieval
RAGBENCH_TOP_K=5
RAGBENCH_RERANK_FETCH_K=20
